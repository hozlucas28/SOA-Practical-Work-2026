    {
        "id": "fn-store",
        "type": "function",
        "z": "soaflow",
        "name": "Guardar ultimo estado",
        "func": "// Cachea en flow context lo ultimo que publica cada gondola.\n// Estado anidado por estante: shelf[NN] = { stock, security }.\nconst parts = msg.topic.split('/');   // soa / {id} / ...\nconst id = parts[1];\nconst kind = parts[2];\nlet state = flow.get('state') || {};\nlet s = state[id] || { availability: null, status: null, shelf: {} };\n\nif (kind === 'availability') {\n    s.availability = msg.payload;\n} else if (kind === 'status') {\n    s.status = msg.payload;\n} else if (kind === 'shelf') {\n    const nn = parts[3];        // '01' | '02'\n    const sub = parts[4];       // 'stock' | 'security'\n    s.shelf[nn] = s.shelf[nn] || {};\n    s.shelf[nn][sub] = msg.payload;\n}\n\ns.updatedAt = Date.now();\nstate[id] = s;\nflow.set('state', state);\nreturn null;",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 150,
        "wires": []
    },
    {
        "id": "dbg-rx",
        "type": "debug",
        "z": "soaflow",
        "name": "RX ESP32",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 440,
        "y": 280,
        "wires": []
    },

    {
        "id": "http-get-state",
        "type": "http in",
        "z": "soaflow",
        "name": "GET estado",
        "url": "/api/:id/state",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 400,
        "wires": [["fn-get-state"]]
    },
    {
        "id": "fn-get-state",
        "type": "function",
        "z": "soaflow",
        "name": "Leer cache",
        "func": "const id = msg.req.params.id;\nconst state = flow.get('state') || {};\nif (state[id]) {\n    msg.statusCode = 200;\n    msg.payload = state[id];\n} else {\n    msg.statusCode = 404;\n    msg.payload = { error: 'sin datos para ' + id };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 400,
        "wires": [["http-resp"]]
    },

    {
        "id": "http-cmd-stock",
        "type": "http in",
        "z": "soaflow",
        "name": "POST cmd/stock",
        "url": "/api/:id/cmd/stock",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 460,
        "wires": [["fn-stock"]]
    },
    {
        "id": "fn-stock",
        "type": "function",
        "z": "soaflow",
        "name": "cmd/stock",
        "func": "// Toggle independiente del modo Stock. Acepta {\"on\":true/false}, {\"stock\":\"ON\"} o texto plano.\nconst id = msg.req.params.id;\nconst body = msg.payload || {};\nlet v = (typeof body === 'object') ? (body.on !== undefined ? body.on : body.stock) : body;\nconst on = (typeof v === 'boolean') ? v : ['ON', 'TRUE', '1'].includes(String(v).toUpperCase());\nconst pub = { topic: `soa/${id}/cmd/stock`, qos: 1, payload: on ? 'ON' : 'OFF' };\nmsg.statusCode = 200;\nmsg.payload = { ok: true, topic: pub.topic, payload: pub.payload };\nreturn [pub, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 460,
        "wires": [["out-cmd"], ["http-resp"]]
    },
    {
        "id": "http-cmd-security",
        "type": "http in",
        "z": "soaflow",
        "name": "POST cmd/security",
        "url": "/api/:id/cmd/security",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 170,
        "y": 610,
        "wires": [["fn-security"]]
    },
    {
        "id": "fn-security",
        "type": "function",
        "z": "soaflow",
        "name": "cmd/security",
        "func": "// Toggle independiente del modo Security (prioritario en la FSM). Acepta {\"on\":true/false}, {\"security\":\"ON\"} o texto plano.\nconst id = msg.req.params.id;\nconst body = msg.payload || {};\nlet v = (typeof body === 'object') ? (body.on !== undefined ? body.on : body.security) : body;\nconst on = (typeof v === 'boolean') ? v : ['ON', 'TRUE', '1'].includes(String(v).toUpperCase());\nconst pub = { topic: `soa/${id}/cmd/security`, qos: 1, payload: on ? 'ON' : 'OFF' };\nmsg.statusCode = 200;\nmsg.payload = { ok: true, topic: pub.topic, payload: pub.payload };\nreturn [pub, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 610,
        "wires": [["out-cmd"], ["http-resp"]]
    },


    },
    {
        "id": "fn-tare-upsert",
        "type": "function",
        "z": "soaflow",
        "name": "UPSERT offset",
        "func": "const id = msg.topic.split('/')[1];\nconst body = msg.payload || {};\nconst shelf = String(body.shelf);\nconst ts = Date.now();\nlet st = flow.get('state') || {};\nlet s = st[id] || {};\ns.tare = s.tare || { \"01\": { done: false }, \"02\": { done: false } };\ns.tare[shelf] = { done: true, ts: ts };\nst[id] = s;\nflow.set('state', st);\nmsg.params = { $id: id, $shelf: shelf, $offset: Number(body.offset), $ts: ts };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 820,
        "wires": [["soa-sql-upsert"]]
    },
    {
        "id": "soa-sql-upsert",
        "type": "sqlite",
        "z": "soaflow",
        "mydb": "soadb",
        "sqlquery": "prepared",
        "sql": "INSERT INTO tare(device_id, shelf, offset, updated_at) VALUES($id,$shelf,$offset,$ts) ON CONFLICT(device_id, shelf) DO UPDATE SET offset=$offset, updated_at=$ts",
        "name": "soa.db",
        "x": 580,
        "y": 820,
        "wires": [[]]
    }

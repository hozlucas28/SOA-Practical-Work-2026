    },
    {
        "id": "soa-sql-select",
        "type": "sqlite",
        "z": "soaflow",
        "mydb": "soadb",
        "sqlquery": "prepared",
        "sql": "SELECT shelf, offset, updated_at FROM tare WHERE device_id = $id",
        "name": "soa.db",
        "x": 560,
        "y": 760,
        "wires": [["fn-tare-state"]]
    },
    {
        "id": "fn-tare-state",
        "type": "function",
        "z": "soaflow",
        "name": "build tare/state",
        "func": "const rows = msg.payload || [];\nconst out = { \"01\": null, \"02\": null };\nfor (const r of rows) { out[r.shelf] = { offset: r.offset, ts: r.updated_at }; }\nlet st = flow.get('state') || {};\nlet s = st[msg.deviceId] || {};\ns.tare = { \"01\": out[\"01\"] ? { done: true, ts: out[\"01\"].ts } : { done: false }, \"02\": out[\"02\"] ? { done: true, ts: out[\"02\"].ts } : { done: false } };\nst[msg.deviceId] = s;\nflow.set('state', st);\nmsg.topic = \"soa/\" + msg.deviceId + \"/tare/state\";\nmsg.payload = JSON.stringify(out);\nmsg.qos = 1;\nmsg.retain = false;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 760,
        "wires": [["out-tare-state"]]
    },

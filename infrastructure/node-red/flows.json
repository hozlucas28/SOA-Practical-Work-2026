        "z": "soaflow",
        "name": "RX tare/save",
        "topic": "soa/+/tare/save",
        "qos": "1",
        "datatype": "json",
        "broker": "brk",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,

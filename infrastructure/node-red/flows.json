    {
        "id": "fn-tare-select",
        "type": "function",
        "z": "soaflow",
        "name": "SELECT offsets",
        "func": "const id = msg.topic.split('/')[1];\nmsg.deviceId = id;\nmsg.params = { $id: id };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 760,
